{
  "name": "durable-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "bash scripts/start.sh",
    "test": "node --test test/*.test.ts",
    "lint": "oxlint --deny-warnings && eslint --flag unstable_native_nodejs_ts_config --max-warnings=0 .",
    "check": "tsc --noEmit && npm run lint && node scripts/check.ts"
