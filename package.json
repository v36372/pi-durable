  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.3"
  }
}
